          <button type="button" class="tb tb-photo" data-src="{% render 'box-imagem', c: 'classica', i: 1, r: 'camisa-masculina-02-camisa-chelsea-i-2324-nike-azul.webp' %}" data-label="{% render 'box-imagem', c: 'classica', i: 1, campo: 'titulo', rt: 'Chelsea 23/24' %}" data-cover="0" aria-label="{% render 'box-imagem', c: 'classica', i: 1, campo: 'titulo', rt: 'Chelsea 23/24' %}"><img src="{% render 'box-imagem', c: 'classica', i: 1, p: true, r: 'camisa-masculina-02-camisa-chelsea-i-2324-nike-azul-p.webp' %}" alt="" loading="lazy" width="420" height="420"></button>
