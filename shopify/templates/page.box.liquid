{% layout 'box' %}

<main>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-orb orb-a"></div>
    <div class="hero-orb orb-b"></div>
  </div>
  <div class="container hero-inner">
    <div class="hero-pill"><span class="pill-dot"></span>Da Sports · Caixa Misteriosa Oficial</div>
    <h1 class="hero-h1 split-now" data-split>
      <span class="l">Você não escolhe</span>
      <span class="l">o manto.</span>
      <span class="l l-alt">O manto escolhe você.</span>
    </h1>
    <p class="hero-sub">Camisas de futebol nacionais e internacionais — retrô, clubes e seleções. Curadoria especializada, estoque no Brasil.</p>
    <div class="hero-actions">
      <a class="btn btn-main" href="#quiz">Montar minha box <span class="arr">→</span></a>
      <a class="btn btn-ghost" href="#boxes">Ver as boxes</a>
    </div>

    <div class="reveal" id="heroFan">
      <div class="rv-light" aria-hidden="true">
        <div class="rv-rays"><i></i><i></i></div>
        <div class="rv-glow"></div>
        <div class="rv-motes" id="rvMotes"></div>
      </div>
      <div class="rv-shirts" aria-hidden="true">
        <div class="rv-shirt far" style="--x:-38cqw;--y:15cqw;--r:-12deg;--delay:.1s"><div class="rv-card"><img src="{% render 'box-imagem', c: 'retro', i: 4, p: true, r: 'camisa-retro-05-flamengo-retro-19921993-home-p.webp' %}" alt="" width="420" height="420"></div></div>
        <div class="rv-shirt" style="--x:-19cqw;--y:2cqw;--r:-6deg;--delay:0s"><div class="rv-card"><img src="{% render 'box-imagem', c: 'retro', i: 0, p: true, r: 'camisa-retro-01-camisa-juventus-retro-2010-preta-e-branca-p.webp' %}" alt="" width="420" height="420"></div></div>
        <div class="rv-shirt" style="--x:19cqw;--y:2cqw;--r:6deg;--delay:.05s"><div class="rv-card"><img src="{% render 'box-imagem', c: 'feminino', i: 2, p: true, r: 'camisa-feminina-03-camisa-feminina-alemanha-202627-i-p.webp' %}" alt="" width="420" height="420"></div></div>
        <div class="rv-shirt far" style="--x:38cqw;--y:15cqw;--r:12deg;--delay:.15s"><div class="rv-card"><img src="{% render 'box-imagem', c: 'retro', i: 1, p: true, r: 'camisa-retro-02-camisa-manchester-united-home-1-199899-umbro-retro-masculina-p.webp' %}" alt="" width="420" height="420"></div></div>
      </div>
      <div class="rv-sparks" id="rvSparks" aria-hidden="true"></div>
      <button type="button" class="rv-box" id="rvBox" aria-label="Abrir a caixa misteriosa">
        <span class="rv-inside"></span>
        <span class="rv-base"><span class="rv-q">?</span><span class="rv-tag">DA SPORTS BOX</span></span>
        <span class="rv-leak"></span>
        <span class="rv-lid">
          <span class="rv-lid-front"></span>
          <span class="rv-bow"><i></i><i></i><b></b><b></b></span>
        </span>
      </button>
      <div class="rv-flash" aria-hidden="true"></div>
      <span class="rv-hint">Toque na caixa pra embaralhar</span>
    </div>

    <div class="hero-stats">
      <div><div class="stat-n" data-count="9" data-prefix="+" data-suffix="mil">+9mil</div><div class="stat-l">camisas entregues</div></div>
      <div><div class="stat-n" data-count="4.9" data-decimals="1" data-suffix="★">4.9★</div><div class="stat-l">avaliação média</div></div>
      <div><div class="stat-n" data-count="2" data-suffix="x">2x</div><div class="stat-l">sem juros</div></div>
      <div><div class="stat-n" data-count="30" data-suffix="d">30d</div><div class="stat-l">garantia de troca</div></div>
    </div>
  </div>
</section>

<!-- FAIXA DE CLUBES -->
<div class="clubs" aria-hidden="true">
  <div class="clubs-track">
    <span>Real Madrid</span><i>✦</i><span>Milan</span><i>✦</i><span>Boca Juniors</span><i>✦</i><span>Ajax</span><i>✦</i><span>Japão</span><i>✦</i><span>Flamengo</span><i>✦</i><span>Juventus</span><i>✦</i><span>Nigéria</span><i>✦</i><span>Barcelona</span><i>✦</i><span>Holanda 88</span><i>✦</i>
    <span>Real Madrid</span><i>✦</i><span>Milan</span><i>✦</i><span>Boca Juniors</span><i>✦</i><span>Ajax</span><i>✦</i><span>Japão</span><i>✦</i><span>Flamengo</span><i>✦</i><span>Juventus</span><i>✦</i><span>Nigéria</span><i>✦</i><span>Barcelona</span><i>✦</i><span>Holanda 88</span><i>✦</i>
  </div>
</div>

