          <button type="button" class="tb tb-photo" data-src="{% render 'box-imagem', c: 'classica', i: 3, r: 'camisa-retro-05-flamengo-retro-19921993-home.webp' %}" data-label="{% render 'box-imagem', c: 'classica', i: 3, campo: 'titulo', rt: 'Flamengo 92/93' %}" data-cover="0" aria-label="{% render 'box-imagem', c: 'classica', i: 3, campo: 'titulo', rt: 'Flamengo 92/93' %}"><img src="{% render 'box-imagem', c: 'classica', i: 3, p: true, r: 'camisa-retro-05-flamengo-retro-19921993-home-p.webp' %}" alt="" loading="lazy" width="420" height="420"></button>
